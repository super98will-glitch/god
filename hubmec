    function BGAim.IsActive()
        if not BGAim.Enabled then return false end
        if BGAim.KeyMode == "Always" then return true end
        return BGAim.KeyHeld
    end

    function BGAim.GetAimPart(char)
        if not char then return nil end
        if BGAim.AimPart == "Random" then
            local opts = {"Head", "UpperTorso", "LowerTorso"}
            return char:FindFirstChild(opts[math.random(#opts)])
        end
        return char:FindFirstChild(BGAim.AimPart) or char:FindFirstChild("Head")
    end

    function BGAim.IsVisible(char)
        if not BGAim.VisibleCheck then return true end
        local cam = Workspace.CurrentCamera
        local myChar = LocalPlayer.Character
        if not cam or not myChar then return true end
        local myHead = myChar:FindFirstChild("Head")
        local targetPart = BGAim.GetAimPart(char)
        if not myHead or not targetPart then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {myChar, char}
        local dir = (targetPart.Position - myHead.Position)
        local hit = Workspace:Raycast(myHead.Position, dir, params)
        return hit == nil
    end

    function BGAim.GetTarget()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end

        if BGAim.StickyTarget and BGAim.CurrentTarget then
            local p = BGAim.CurrentTarget
            local stillValid = p.Parent and p.Character
                and p.Character:FindFirstChildOfClass("Humanoid")
                and (p.Character:FindFirstChildOfClass("Humanoid").Health > 0)
                and (tick() - BGAim.TargetAcquiredAt) < BGAim.StickyDuration
            if stillValid then
                local part = BGAim.GetAimPart(p.Character)
                if part then
                    local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist <= BGAim.FOV then
                            return p, part
                        end
                    end
                end
            else
                BGAim.CurrentTarget = nil
            end
        end

        local best, bestPart, bestDist = nil, nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer or not p.Character then continue end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            if BGAim.IgnoreFriends and LocalPlayer:IsFriendsWith(p.UserId) then continue end
            local part = BGAim.GetAimPart(p.Character)
            if not part then continue end
            local worldDist = (part.Position - myRoot.Position).Magnitude
            if worldDist > BGAim.Range then continue end
            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if screenDist > BGAim.FOV then continue end
            if not BGAim.IsVisible(p.Character) then continue end
            if screenDist < bestDist then
                bestDist = screenDist
                best = p
                bestPart = part
            end
        end
        if best then
            BGAim.CurrentTarget = best
            BGAim.TargetAcquiredAt = tick()
        end
        return best, bestPart
    end

    function BGAim.PredictPosition(part, myPos)
        if BGAim.Prediction <= 0 then return part.Position end
        local vel = part.AssemblyLinearVelocity
        if typeof(vel) ~= "Vector3" then return part.Position end
        local dist = (part.Position - myPos).Magnitude
        local flyTime = math.min(dist / 500, 0.5)
        local t = flyTime * BGAim.Prediction * 2
        return part.Position + vel * t
    end

    function BGAim.CreateFOVCircle()
