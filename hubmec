        local pStream = UIBuilder.Panel(R, {Title = "STREAM MODE", Description = "Protege a UI contra detecção. Você continua vendo ela normalmente."})

        local StreamMode = {
            Active = false,
            GuardConn = nil,
            Protected = false,
        }

        local function StreamProtectGUI()
            if not gui then return false end
            local ok2 = pcall(function()
                if syn and syn.protect_gui then
                    syn.protect_gui(gui)
                    return
                end
                if gethui then
                    gui.Parent = gethui()
                    return
                end
            end)
            return ok2
        end

        local function SetStreamMode(state)
            StreamMode.Active = state
            if state then
                local protected = StreamProtectGUI()
                StreamMode.Protected = protected

                if not StreamMode.GuardConn then
                    StreamMode.GuardConn = Heartbeat:Connect(function()
                        if not StreamMode.Active then return end
                        if not gui or not gui.Parent then return end
                        if gethui then
                            pcall(function()
                                if gui.Parent == LocalPlayer.PlayerGui then
                                    gui.Parent = gethui()
                                end
                            end)
                        end
                    end)
                end

                pcall(function()
                    gui.Name = "\0" .. gui.Name
                end)

                pcall(function()
                    Notifications.Show("STREAM MODE", protected and "UI protegida contra detecção." or "UI visível, mas proteção indisponível neste executor.", "🛡️", 3)
                end)
            else
                if StreamMode.GuardConn then
                    StreamMode.GuardConn:Disconnect()
                    StreamMode.GuardConn = nil
                end

                pcall(function()
                    if gui and gui.Name:sub(1,1) == "\0" then
                        gui.Name = gui.Name:sub(2)
                    end
                end)

                StreamMode.Protected = false
                pcall(function()
                    Notifications.Show("STREAM MODE", "Proteção desativada.", "🛡️", 3)
                end)
            end
        end

        UIBuilder.Toggle(pStream, {
            Text = "Ativar Stream Mode",
            Default = false,
            Callback = function(s) SetStreamMode(s) end,
        })
        UIBuilder.Label(pStream, "UI continua visível pra você.")

        _G.__L1GHT_STREAM = StreamMode

        task.defer(function()
            if StreamProtectGUI() then
                StreamMode.Protected = true
                print("[StreamMode] GUI auto-protegida na inicialização.")
            end
        end)
        -- ═══════════════ FIM STREAM MODE ═══════════════
    end

