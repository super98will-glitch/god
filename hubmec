local function VFX_FindAll()
    table.clear(VFX.foundVFX)
    local count = 0
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst.Name == "TransformationVFX" and (inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")) then
            table.insert(VFX.foundVFX, inst)
            count = count + 1
        end
    end
    return count
end
local function VFX_ApplyAll()
    if #VFX.foundVFX == 0 then return end
    local seq = ColorSequence.new(VFX.vfxColor)
    for _, effect in ipairs(VFX.foundVFX) do
        if effect and effect.Parent then
            pcall(function()
                if effect:IsA("ParticleEmitter") then effect.Color = seq
                elseif effect:IsA("Trail") then effect.Color = seq
                elseif effect:IsA("Beam") then effect.Color = seq end
            end)
        end
    end
end
local function VFX_SetColor(name)
    if VFX.colorList[name] then
        VFX.vfxColor = VFX.colorList[name]
        VFX.vfxColorName = name
        if VFX.enabled then VFX_FindAll() VFX_ApplyAll() end
        return true
    end
    return false
end
local function VFX_Start()
    if VFX.trackingThread then return end
    VFX.enabled = true
    VFX.trackingThread = task.spawn(function()
        while VFX.enabled do
            VFX_FindAll()
            VFX_ApplyAll()
            task.wait(0.5)
        end
    end)
end
local function VFX_Stop()
    VFX.enabled = false
    if VFX.trackingThread then task.cancel(VFX.trackingThread) VFX.trackingThread = nil end
    table.clear(VFX.foundVFX)
end

