    local BC = {
        Enabled = false, UseAimlock = true, AimlockKey = Enum.KeyCode.E,
        AimlockRange = 15, TargetMode = "Closest", ResponseRange = "Auto",
        FixedRange = 8, Cooldown = 0.5,
        lastResponse = 0, lastHP = nil, lastBlockState = false,
        conn = nil, hitHistory = {},
    }
    function BC.EffectiveRange()
        if BC.ResponseRange == "Fixed" then return BC.FixedRange end
        local base = 6
        if HB and HB.active and type(HB.size) == "number" then base = base + (HB.size * 0.5) end
        if BasicHB and BasicHB.active and type(BasicHB.size) == "number" then base = base + (BasicHB.size * 0.3) end
        return base
    end
    function BC.DetectBlockHit(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local hp = hum:GetAttribute("Health") or hum.Health or 0
        local blockState = char:GetAttribute("LocalBlock") == true
        local hpFell = BC.lastHP and hp < BC.lastHP
        local blockBroke = BC.lastBlockState and not blockState
        local now = tick()
        for i = #BC.hitHistory, 1, -1 do
            if now - BC.hitHistory[i] > 0.6 then table.remove(BC.hitHistory, i) end
        end
        BC.lastHP = hp
        BC.lastBlockState = blockState
        if (hpFell or blockBroke) then
            table.insert(BC.hitHistory, now)
            return true
        end
        return false
    end
    function BC.GetAttacker()
        local my = Helpers.GetHRP(LocalPlayer.Character)
        if not my then return nil end
        local candidates = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer or not p.Character then continue end
            local th = Helpers.GetHRP(p.Character)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not th or not hum or (hum:GetAttribute("Health") or hum.Health or 0) <= 0 then continue end
            local dist = (my.Position - th.Position).Magnitude
            if dist > BC.AimlockRange then continue end
            local attacking = false
            for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                if tr.IsPlaying and tr.Animation and AB_Anims[tr.Animation.AnimationId] then
                    attacking = true
                    break
                end
            end
            if attacking then
                table.insert(candidates, {player = p, dist = dist})
            end
        end
        if #candidates == 0 then
            local t = AimCore.GetTarget({Range = BC.AimlockRange, IgnoreFriends = false, TargetMode = BC.TargetMode})
            if not t or not t.Character then return nil end
            local th = Helpers.GetHRP(t.Character)
            if not th or (my.Position - th.Position).Magnitude > BC.EffectiveRange() then return nil end
            return t
        end
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
        local chosen = candidates[1].player
        local th = Helpers.GetHRP(chosen.Character)
        if not th or (my.Position - th.Position).Magnitude > BC.EffectiveRange() then return nil end
        return chosen
    end
    function BC.Start()
        if BC.conn then return end
        BC.lastHP = nil
        BC.lastBlockState = false
        BC.conn = Heartbeat:Connect(function()
            if not BC.Enabled then return end
            local now = tick()
            if now - BC.lastResponse < BC.Cooldown then return end
            local char = LocalPlayer.Character
            if not char then return end
            local curBlock = char:GetAttribute("LocalBlock")
            if curBlock ~= true then
                pcall(function() RC.Block:FireServer(true) end)
                pcall(function() char:SetAttribute("LocalBlock", true) end)
            end
            if BC.DetectBlockHit(char) then
                local attacker = BC.GetAttacker()
                if attacker then
                    BC.lastResponse = now
                    task.spawn(function() Melee.Attack() end)
                end
            end
        end)
    end
    function BC.Stop()
        if BC.conn then BC.conn:Disconnect() BC.conn = nil end
        local char = LocalPlayer.Character
        if char then
            pcall(function() RC.Block:FireServer(false) end)
            pcall(function() char:SetAttribute("LocalBlock", false) end)
        end
    end

