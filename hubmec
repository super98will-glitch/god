                local ok3 = pcall(function() model = Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R6) end)
                if not ok3 or not model then return nil end
            end
            model.Name = "PreviewModel"
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                end
            end
            model.Parent = vp
            pcall(function() model:PivotTo(CFrame.new(0, 0, 0)) end)
            SkinPreview.rotationConn = RunService.RenderStepped:Connect(function(dt)
                if not SkinPreview.previewModel or not SkinPreview.previewModel.Parent then return end
                local pivot = SkinPreview.previewModel:GetPivot()
                SkinPreview.previewModel:PivotTo(pivot * CFrame.Angles(0, math.rad(dt * 60), 0))
            end)
            return model
        end

