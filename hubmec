function HitBoxManager.Init()
    if HitBoxManager.initialized then return HitBoxManager.lib ~= nil end
    local cm = Services.ReplicatedStorage:WaitForChild("Core", 15)
    if not cm then return false end
    local core
    for _ = 1, 20 do
        local s, r = pcall(require, cm)
        if s and r and type(r.Get) == "function" then core = r; break end
        task.wait(0.1)
    end
    if not core then return false end
    for _ = 1, 20 do
        local s, hl = pcall(function() return core.Get("Combat", "Hit") end)
        if s and hl and type(hl.Box) == "function" then
            HitBoxManager.lib = hl
            HitBoxManager.original = hl.Box
            hl.Box = function(self, ...)
                local args = { ... }
                for _, mod in ipairs(HitBoxManager.mods) do
                    local ok2, res = pcall(mod, args)
