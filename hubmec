    function BGAim.UpdateFOVCircle(hasTarget)
        if not BGAim.fovCircle or not BGAim.fovCircle.Parent then return end
        BGAim.fovCircle.Size = UDim2.fromOffset(BGAim.FOV * 2, BGAim.FOV * 2)
        if BGAim.fovStroke then
            BGAim.fovStroke.Color = hasTarget and Color3.fromRGB(255, 80, 120) or Color3.fromRGB(120, 200, 255)
            BGAim.fovStroke.Transparency = hasTarget and 0.05 or 0.25
        end
    end

    function BGAim.Start()
        if BGAim.conn then return end
        BGAim.CreateFOVCircle()
        BGAim.conn = RenderStepped:Connect(function()
            if not BGAim.IsActive() then
                BGAim.UpdateFOVCircle(false)
                return
            end
            local cam = Workspace.CurrentCamera
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not cam or not myRoot then return end

            local target, aimPart = BGAim.GetTarget()
            BGAim.UpdateFOVCircle(target ~= nil)
            if not target or not aimPart then return end

            local targetPos = BGAim.PredictPosition(aimPart, myRoot.Position)

            if BGAim.Mode == "Camera" then
                local cur = cam.CFrame
                local desired = CFrame.new(cur.Position, targetPos)
                cam.CFrame = cur:Lerp(desired, BGAim.Smoothness)
            else
                local cur = myRoot.CFrame
                local desired = CFrame.new(cur.Position, Vector3.new(targetPos.X, cur.Position.Y, targetPos.Z))
                myRoot.CFrame = cur:Lerp(desired, BGAim.Smoothness)
            end
        end)
    end

    function BGAim.Stop()
        if BGAim.conn then BGAim.conn:Disconnect() BGAim.conn = nil end
        BGAim.CurrentTarget = nil
        BGAim.UpdateFOVCircle(false)
    end

    function BGAim.SetUserEnabled(s)
