        local function CreatePreviewModel(desc, vp)
            if not desc or not vp then return nil end
            for _, c in ipairs(vp:GetChildren()) do if c:IsA("Model") then c:Destroy() end end
            local model
            local ok2 = pcall(function() model = Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15) end)
