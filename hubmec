local ALag = { active = false, conns = {} }
local function cleanEffects()
    pcall(function()
        local ef = Workspace:FindFirstChild("Misc") and Workspace.Misc:FindFirstChild("Effects")
        if not ef then return end
        local children = ef:GetChildren()
        local count = 0
        for i = #children, 1, -1 do
            local child = children[i]
            if child and child.Parent then
                if child:IsA("Model") or child:IsA("BasePart") or child:IsA("Beam") then
                    local isChar = false
                    local p = child
                    while p do
                        if p:IsA("Model") and p:FindFirstChild("Humanoid") then isChar = true break end
                        p = p.Parent
                    end
                    if not isChar then
                        child:Destroy()
                        count = count + 1
                    end
                end
            end
        end
        if count > 50 then
            for _, child in ipairs(ef:GetChildren()) do
                if child:IsA("Model") or child:IsA("BasePart") then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end)
end
local function startALag()
    if #ALag.conns > 0 then return end
    pcall(function()
        local ef = Workspace:FindFirstChild("Misc") and Workspace.Misc:FindFirstChild("Effects")
        if ef then
            local c = ef.ChildAdded:Connect(function(child)
                if not ALag.active then return end
                if child and (child:IsA("Model") or child:IsA("BasePart") or child:IsA("Beam")) then
                    pcall(function() child:Destroy() end)
                end
            end)
            table.insert(ALag.conns, c)
        end
    end)
    table.insert(ALag.conns, task.spawn(function()
        while ALag.active do
            cleanEffects()
            task.wait(0.05)
        end
    end))
    cleanEffects()
end
local function stopALag()
    ALag.active = false
    for _, c in ipairs(ALag.conns) do
        pcall(function() c:Disconnect() end)
        pcall(task.cancel, c)
    end
    table.clear(ALag.conns)
end

