    function ESP.Update()
        if not ESP.Enabled then return end
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local myPos = myHRP.Position
        local now = tick()
        local active = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and (hum:GetAttribute("Health") or hum.Health or 0) > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= ESP.Range then
                    local intel = ESP.GetIntel(p)
                    for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                        if tr.IsPlaying and tr.Animation and AB_Anims[tr.Animation.AnimationId] then
                            intel.attackAnimSeenAt = now
                            break
                        end
                    end
                    local rawRagdoll = false
                    pcall(function()
                        if hum.PlatformStand then rawRagdoll = true end
                        if hum:GetState() == Enum.HumanoidStateType.Physics then rawRagdoll = true end
                    end)
                    local combatRagdoll = rawRagdoll and (now - intel.attackAnimSeenAt) <= 0.5
                    if combatRagdoll and not intel.wasRagdolled then intel.ragdollStart = now
                    elseif not rawRagdoll and intel.wasRagdolled then intel.ragdollStart = nil end
                    intel.wasRagdolled = combatRagdoll
                    if intel.lastPos and (hrp.Position - intel.lastPos).Magnitude > 1.5 then intel.lastDashTick = now end
                    intel.lastPos = hrp.Position
                    local tl = nil
                    if combatRagdoll and intel.ragdollStart then
                        tl = math.max(0, ESP.RagdollDur - (now - intel.ragdollStart))
                    end
                    local cd = math.max(0, ESP.EvasiveCD - (now - intel.lastDashTick))
                    active[p] = { combatRagdoll = combatRagdoll, tempoLevantar = tl, temEvasive = cd <= 0, cdRestante = cd }
                end
            end
        end
        ESP.CreateHUD()
        if not ESP.hudFrame or not ESP.hudFrame.Parent then return end
        ESP.hudFrame.Visible = true
        for p, rd in pairs(ESP.rows) do
            if not active[p] then
                if rd.row and rd.row.Parent then rd.row:Destroy() end
                ESP.rows[p] = nil
            end
        end
        for p, info in pairs(active) do
            local rd = ESP.rows[p] or ESP.CreateRow(p)
            if info.combatRagdoll and info.tempoLevantar then
                rd.levanta.Text = string.format("Levanta: %.1fs", info.tempoLevantar)
                rd.levanta.TextColor3 = Theme.Warning
            else
                rd.levanta.Text = "Levanta: —"
                rd.levanta.TextColor3 = Theme.TextMuted
            end
            if info.temEvasive then
                rd.escape.Text = "Escape: ✅"
                rd.escape.TextColor3 = Theme.Success
            else
                rd.escape.Text = string.format("Escape: %.1fs", info.cdRestante)
                rd.escape.TextColor3 = Theme.Danger
            end
        end
    end
