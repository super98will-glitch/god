do
    local LP = LocalPlayer
    local ThemeManager = {
        Current = "Default",
        Themes = {
            ["Default"] = {
                Background=Color3.fromRGB(6,6,10), Surface=Color3.fromRGB(12,12,18),
                SurfaceSecondary=Color3.fromRGB(18,18,26), Card=Color3.fromRGB(14,14,22),
                CardHover=Color3.fromRGB(20,20,30), Accent=Color3.fromRGB(120,130,155),
                AccentDim=Color3.fromRGB(60,65,85), Text=Color3.fromRGB(240,240,250),
                TextSecondary=Color3.fromRGB(160,160,175), TextMuted=Color3.fromRGB(110,110,125),
                Border=Color3.fromRGB(30,30,42), BorderLight=Color3.fromRGB(48,48,62),
                BackgroundImage="", BackgroundImageTransparency=1,
            },
            ["ZeroTwo"] = {
                Background=Color3.fromRGB(10,12,18), Surface=Color3.fromRGB(16,24,45),
                SurfaceSecondary=Color3.fromRGB(24,34,60), Card=Color3.fromRGB(20,30,55),
                CardHover=Color3.fromRGB(32,46,78), Accent=Color3.fromRGB(255,80,140),
                AccentDim=Color3.fromRGB(180,40,95), Text=Color3.fromRGB(235,240,250),
                TextSecondary=Color3.fromRGB(160,180,215), TextMuted=Color3.fromRGB(110,130,165),
                Border=Color3.fromRGB(60,20,40), BorderLight=Color3.fromRGB(90,30,60),
                BackgroundImage="rbxassetid://87353595377346", BackgroundImageTransparency=0.55,
            },
        }
    }
    local function recolorTree(obj, t)
        if not obj or not obj.Parent then return end
        if obj:IsA("Frame") or obj:IsA("TextButton") then
            if obj.Name == "Window" then obj.BackgroundColor3 = t.Surface
            elseif obj.Name == "Header" then obj.BackgroundColor3 = Color3.fromRGB(13,17,29)
            elseif obj.Name == "Sidebar" then obj.BackgroundColor3 = t.SurfaceSecondary
            elseif obj:FindFirstChildOfClass("UIStroke") then
                if obj:IsA("TextButton") and obj.Text ~= "" and obj.Text ~= "✕" then
                    obj.BackgroundColor3 = t.AccentDim
                else
                    obj.BackgroundColor3 = t.Card
                end
            end
            local stroke = obj:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = t.Border
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                stroke.LineJoinMode = Enum.LineJoinMode.Round
            end
        end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if obj.Name == "__Crown" then
                obj.TextColor3 = Color3.fromRGB(250,204,21)
            elseif obj.Parent and obj.Parent.Name == "Header" then
                local txt = obj.Text or ""
                if txt:find("GOD'S PLAN", 1, true) then obj.TextColor3 = Color3.fromRGB(255,255,255)
                elseif txt:find("FPS") then obj.TextColor3 = Color3.fromRGB(34,197,94)
                elseif txt:find("ms") then obj.TextColor3 = Color3.fromRGB(209,213,219)
                elseif txt:match("^%d?%d:%d%d$") then obj.TextColor3 = Color3.fromRGB(156,163,175) end
            elseif obj.TextSize >= 13 then obj.TextColor3 = t.Text
            elseif obj.TextSize >= 11 then obj.TextColor3 = t.TextSecondary
            else obj.TextColor3 = t.TextMuted end
        end
        for _, c in ipairs(obj:GetChildren()) do recolorTree(c, t) end
    end
    function ThemeManager:Apply(name)
        local t = self.Themes[name]
        if not t then return end
        self.Current = name
        local UIRef = _G.__L1GHT_UI
        if UIRef and UIRef.Theme then
            for k, v in pairs(t) do UIRef.Theme[k] = v end
        end
        local guiRef = (UIRef and UIRef.gui) or LP.PlayerGui:FindFirstChild("L1GHTHub")
        if not guiRef then return end
        local window = guiRef:FindFirstChild("Window")
        if not window then return end
        recolorTree(window, t)
        local bg = window:FindFirstChild("__ThemeBackground")
        if not bg then
            bg = Instance.new("ImageLabel")
            bg.Name = "__ThemeBackground"
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.Position = UDim2.fromOffset(0, 0)
            bg.BackgroundTransparency = 1
            bg.BorderSizePixel = 0
            bg.ZIndex = window.ZIndex
            bg.Active = false
            bg.Selectable = false
            bg.Parent = window
        end
        if t.BackgroundImage and t.BackgroundImage ~= "" then
            bg.Image = t.BackgroundImage
            bg.ImageTransparency = t.BackgroundImageTransparency or 0.5
        else
            bg.Image = ""
            bg.ImageTransparency = 1
        end
    end
    _G.ThemeManager = ThemeManager
end
