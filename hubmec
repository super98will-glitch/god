-- ================================================================
local CharSwitcher = { lastPos = nil }
local function saveCurrentPosition()
    local hrp = Helpers.GetHRP(LocalPlayer.Character)
    if hrp then CharSwitcher.lastPos = hrp.CFrame end
end
local function switchCharacter(characterName)
    saveCurrentPosition()
    local rootPart = Helpers.GetHRP(LocalPlayer.Character)
    if rootPart then
        rootPart.CFrame = CFrame.new(1011.1289672851562, -1009.359588623046875, 116.37605285644531)
    end
    if RC.ChangeChar then RC.ChangeChar:FireServer(characterName) end
    local groundY
    pcall(function()
        local g = workspace.Map.Structural.Ground:GetChildren()
        if g[21] then groundY = g[21].Position.Y end
    end)
    if groundY then
        local t = tick() + 5
        while tick() < t do
            local hrp = Helpers.GetHRP(LocalPlayer.Character)
            if hrp and hrp.Position.Y > groundY then break end
            task.wait()
        end
    end
    task.wait(0.15)
    local newRoot = Helpers.GetHRP(LocalPlayer.Character)
    if newRoot and CharSwitcher.lastPos then
        local t = tick() + 3
        while tick() < t do
            newRoot.CFrame = CharSwitcher.lastPos
            task.wait(0.1)
            if (newRoot.Position - CharSwitcher.lastPos.Position).Magnitude < 10 then break end
        end
    end
end

