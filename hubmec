local InvisV1 = { active = false, blockRemote = false, hooked = false, mt = nil, old = nil, generation = 0, savedCFrame = nil }

local function toggleInvisV1(state)
    InvisV1.generation = InvisV1.generation + 1
    local myGen = InvisV1.generation

    if state then
        local Remote = RC and RC.Replication
        if not Remote then
            InvisV1.active = false
            InvisV1.blockRemote = false
            return
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            InvisV1.active = false
            InvisV1.blockRemote = false
            return
        end
        if not InvisV1.hooked and getrawmetatable and setreadonly then
            InvisV1.hooked = true
            local mt = getrawmetatable(game)
            InvisV1.mt = mt
            setreadonly(mt, false)
            local old = mt.__namecall
            InvisV1.old = old
            mt.__namecall = newcclosure(function(self, ...)
                if self == RC.Replication and getnamecallmethod() == "FireServer" and InvisV1.blockRemote and InvisV1.active then
                    return nil
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
        end
        InvisV1.active = true
        InvisV1.savedCFrame = hrp.CFrame
        local flyingCF = hrp.CFrame + Vector3.new(0, 50000, 0)
        task.spawn(function()
            for i = 1, 10 do
                if InvisV1.generation ~= myGen or not InvisV1.active then return end
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChild("HumanoidRootPart")
                if not h then return end
                h.CFrame = flyingCF
                pcall(function() Remote:FireServer() end)
                task.wait(0.1)
            end
            if InvisV1.generation == myGen and InvisV1.active then
                InvisV1.blockRemote = true
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChild("HumanoidRootPart")
                if h and InvisV1.savedCFrame then
                    h.CFrame = InvisV1.savedCFrame
                end
            end
        end)
    else
        InvisV1.active = false
        InvisV1.blockRemote = false
        InvisV1.savedCFrame = nil
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if h and h.Position.Y > 40000 then
            h.CFrame = CFrame.new(h.Position.X, 5, h.Position.Z)
        end
    end
end

