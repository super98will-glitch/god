        if ok2 and ping then pingLabel.Text = math.floor(ping * 1000) .. " ms" end
    end))

    local fpsCounter = 0
    local lastFpsCheck = tick()
    Track(RenderStepped:Connect(function()
        fpsCounter = fpsCounter + 1
        if tick() - lastFpsCheck >= 1 then
            local c = fpsCounter >= 50 and Theme.Green or (fpsCounter >= 30 and Theme.Yellow or Theme.Red)
            fpsLabel.Text = fpsCounter .. " FPS"
            fpsLabel.TextColor3 = c
            fpsCounter = 0
            lastFpsCheck = tick()
        end
    end))

    -- ═══════════════ ATALHO 2x TAB ═══════════════
    local lastTabTime = 0
    local tabCount = 0
    if _G._L1GHT_TAB_Conn then pcall(function() _G._L1GHT_TAB_Conn:Disconnect() end) end
    _G._L1GHT_TAB_Conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Tab then
            local now = tick()
            if now - lastTabTime < 0.35 then
                tabCount = tabCount + 1
                if tabCount >= 2 then
                    tabCount = 0
                    Window.Visible = not Window.Visible
                end
            else
                tabCount = 1
            end
            lastTabTime = now
        end
    end)
