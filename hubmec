local function AB_Loop()
    if not AB.Enabled or not RC.Block then return end
    local char = LocalPlayer.Character; local root = Helpers.GetHRP(char)
    if not root then return end
    local threats = {}; local nearby = false; local closestEnemy = nil; local closestDist = AB.Range
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local r = Helpers.GetHRP(p.Character); local h = p.Character:FindFirstChildOfClass("Humanoid")
        if not r or not h then continue end
        local dist = (root.Position - r.Position).Magnitude
        if dist > AB.Range then continue end
        nearby = true
        if dist < closestDist then closestDist = dist; closestEnemy = r end
        for _, tr in ipairs(h:GetPlayingAnimationTracks()) do
            if tr.IsPlaying and tr.Animation and AB_Anims[tr.Animation.AnimationId] then
                table.insert(threats, tr); break
            end
        end
    end
    if not nearby then
        if tick() - AB.last >= 0.045 then
            pcall(function() RC.Block:FireServer(false) end)
            pcall(function() char:SetAttribute("LocalBlock", false) end)
            AB.last = tick()
        end
        AB.cache = {}
        return
    end
    if closestEnemy then
        local dir = (closestEnemy.Position - root.Position); dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude > 0.001 then
            root.CFrame = CFrame.lookAt(root.Position, root.Position + dir.Unit)
        end
    end
    if #threats == 0 then
        AB.timer = math.max(AB.timer, tick() + 0.15)
    else
        for _, tr in ipairs(threats) do
            if not AB.cache[tr] then
                AB.cache[tr] = true
                AB.timer = math.max(AB.timer, tick() + (tr.Length or 0.2) + 0.85)
            end
        end
    end
    if tick() <= AB.timer then
        if tick() - AB.last >= 0.045 then
            pcall(function() RC.Block:FireServer(true) end)
            pcall(function() char:SetAttribute("LocalBlock", true) end)
            AB.last = tick()
        end
    else
        pcall(function() RC.Block:FireServer(false) end)
        pcall(function() char:SetAttribute("LocalBlock", false) end)
        AB.cache = {}
    end
end

function AB.Start()
    if AB._conn then return end
    AB._conn = RenderStepped:Connect(AB_Loop)
end

function AB.Stop()
    if AB._conn then AB._conn:Disconnect() AB._conn = nil end
    local char = LocalPlayer.Character
    if char then
        pcall(function() RC.Block:FireServer(false) end)
        pcall(function() char:SetAttribute("LocalBlock", false) end)
    end
    AB.cache = {}
    AB.timer = 0
end

