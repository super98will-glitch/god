_G.__L1GHT_MGR = nil

do
    -- ──────────── MELEE ────────────
    local Melee = { env = nil, m1Listeners = {} }

    function Melee.Get()
        if Melee.env and type(Melee.env.activate) == "function" then return Melee.env end
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local cb = ps and ps:FindFirstChild("Combat")
        local ms = cb and cb:FindFirstChild("Melee")
        if not ms or not getsenv then return nil end
        local ok2, env = pcall(getsenv, ms)
        if not ok2 or type(env) ~= "table" then return nil end
        if type(env.activate) ~= "function" then return nil end
        Melee.env = env
        local orig = env.activate
        env.activate = function(...)
            for _, cb2 in ipairs(Melee.m1Listeners) do pcall(cb2) end
            return orig(...)
        end
        return env
    end

    function Melee.Attack()
        local env = Melee.Get()
        if not env then return false end
        return pcall(env.activate)
    end

    function Melee.OnM1(cb) table.insert(Melee.m1Listeners, cb) end

    task.spawn(function()
        for _ = 1, 30 do
            if Melee.Get() then print("[Melee] Carregado") return end
            task.wait(0.5)
        end
        warn("[Melee] Não carregou em 15s")
    end)

    -- ──────────── AIMCORE ────────────
    local AimCore = {}
    function AimCore.GetTarget(cfg)
        local lr = Helpers.GetHRP(LocalPlayer.Character)
        if not lr then return nil end
        local range = cfg.Range or 100
        local ignoreFriends = cfg.IgnoreFriends or false
        local mode = cfg.TargetMode or "Closest"
        local best, bestScore = nil, math.huge
        if mode == "LowestHP" then
            local lowestHP = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer or not p.Character then continue end
                local pt = Helpers.GetHRP(p.Character)
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if not pt or not hum then continue end
                if ignoreFriends and LocalPlayer:IsFriendsWith(p.UserId) then continue end
                local d = (lr.Position - pt.Position).Magnitude
                if d > range then continue end
                local hp = hum:GetAttribute("Health") or hum.Health or 0
                if hp <= 0 then continue end
                if hp < lowestHP then lowestHP = hp; best = p end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer or not p.Character then continue end
                local pt = Helpers.GetHRP(p.Character)
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if not pt or not hum then continue end
                if (hum:GetAttribute("Health") or hum.Health or 0) <= 0 then continue end
                if ignoreFriends and LocalPlayer:IsFriendsWith(p.UserId) then continue end
                local d = (lr.Position - pt.Position).Magnitude
                if d < bestScore and d <= range then bestScore = d; best = p end
            end
        end
        return best
    end

    -- ──────────── AIMLOCK NORMAL (P1) ────────────
    local AIM = {
        UserEnabled = false,
        KeyHeld = false,
        Mode = "Always",
        Key = Enum.KeyCode.F,
        Range = 30,
        Smoothness = 0.2,
        IgnoreFriends = false,
        TargetMode = "Closest",
        conn = nil,
        keyConn = nil,
        keyEndConn = nil,
        _toggleHandle = nil,
    }

    function AIM.IsActive()
        if not AIM.UserEnabled then return false end
        if AIM.Mode == "Always" then return true end
        return AIM.KeyHeld
    end

    function AIM.Start()
        if AIM.conn then return end
        AIM.conn = RenderStepped:Connect(function()
            if not AIM.IsActive() then return end
            local lr = Helpers.GetHRP(LocalPlayer.Character)
            if not lr then return end
            local t = AimCore.GetTarget({
