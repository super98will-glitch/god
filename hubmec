        Key = Enum.KeyCode.F,

        Mode = "Camera",
        AimPart = "Head",

        Range = 500,
        FOV = 120,
        Smoothness = 0.25,
        Prediction = 0.12,

        StickyTarget = true,
        StickyDuration = 1.5,

        VisibleCheck = false,
        IgnoreFriends = true,

        CurrentTarget = nil,
        TargetAcquiredAt = 0,
