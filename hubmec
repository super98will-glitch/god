-- SEÇÃO 35: INVISIBLE V2
-- ================================================================
local InvisV2 = {
    enabled = false, mirrorModel = nil, mirrorHRP = nil,
    movementConn = nil, positionConn = nil, cleanupConn = nil,
    savedProps = {}, hiddenY = 0, originalCameraSubject = nil,
}

local function InvisV2_Cleanup()
    if InvisV2.movementConn then pcall(function() InvisV2.movementConn:Disconnect() end) InvisV2.movementConn = nil end
    if InvisV2.positionConn then pcall(function() InvisV2.positionConn:Disconnect() end) InvisV2.positionConn = nil end
    if InvisV2.cleanupConn then pcall(function() InvisV2.cleanupConn:Disconnect() end) InvisV2.cleanupConn = nil end
    if InvisV2.mirrorModel then pcall(function() InvisV2.mirrorModel:Destroy() end) InvisV2.mirrorModel = nil InvisV2.mirrorHRP = nil end
    local char = LocalPlayer.Character
    if char then
        for part, props in pairs(InvisV2.savedProps) do
            if part and part.Parent then
                pcall(function()
                    part.Transparency = props.Transparency
                    part.CanCollide = props.CanCollide
                    part.Anchored = props.Anchored
                end)
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer end)
        end
    end
    InvisV2.savedProps = {}
    pcall(function()
        local curChar = LocalPlayer.Character
        if curChar then
            local h = curChar:FindFirstChildOfClass("Humanoid")
            if h then workspace.CurrentCamera.CameraSubject = h
            elseif InvisV2.originalCameraSubject then workspace.CurrentCamera.CameraSubject = InvisV2.originalCameraSubject end
        elseif InvisV2.originalCameraSubject then
            workspace.CurrentCamera.CameraSubject = InvisV2.originalCameraSubject
        end
    end)
    InvisV2.enabled = false
end

local function toggleInvisV2(state)
    if state then
        if InvisV2.enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local groundUnion
        pcall(function() groundUnion = Workspace.Map.Structural.Ground.Union end)
        if not groundUnion then return end
        InvisV2.enabled = true
        InvisV2.originalCameraSubject = workspace.CurrentCamera.CameraSubject
        InvisV2.hiddenY = groundUnion.Position.Y - 100
        InvisV2.savedProps = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                InvisV2.savedProps[part] = {
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide,
                    Anchored = part.Anchored,
                }
                part.Transparency = 1
                part.CanCollide = false
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
        local ok2, err = pcall(function()
            if not char.Archivable then char.Archivable = true end
            local clone = char:Clone()
            clone.Name = "MirrorClone"
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("Script") or d:IsA("LocalScript") then
                    d:Destroy()
                elseif d:IsA("BasePart") then
                    d.Transparency = 0
                    d.CanCollide = false
                    d.Massless = true
                    d.Anchored = true
                end
            end
            clone.Parent = Workspace
            InvisV2.mirrorModel = clone
            InvisV2.mirrorHRP = clone:FindFirstChild("HumanoidRootPart")
            if InvisV2.mirrorHRP then
                InvisV2.mirrorHRP.CFrame = CFrame.new(hrp.Position.X, groundUnion.Position.Y + 3, hrp.Position.Z)
            end
        end)
        if not ok2 then
            warn("[InvisV2] Falha ao criar mirror:", err)
            InvisV2_Cleanup()
            return
        end
        local mirrorHum = InvisV2.mirrorModel:FindFirstChildOfClass("Humanoid")
        workspace.CurrentCamera.CameraSubject = mirrorHum or InvisV2.mirrorHRP
        InvisV2.positionConn = RunService.Heartbeat:Connect(function()
            if not InvisV2.enabled then return end
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            local pos = h.Position
            local look = h.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, 1) end
            h.CFrame = CFrame.lookAt(
                Vector3.new(pos.X, InvisV2.hiddenY, pos.Z),
                Vector3.new(pos.X, InvisV2.hiddenY, pos.Z) + flat.Unit
            )
            h.AssemblyLinearVelocity = Vector3.new(
                h.AssemblyLinearVelocity.X, 0, h.AssemblyLinearVelocity.Z
            )
        end)
        InvisV2.movementConn = RunService.Heartbeat:Connect(function()
            if not InvisV2.enabled then return end
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            if not InvisV2.mirrorHRP or not InvisV2.mirrorHRP.Parent then return end
            local groundY = groundUnion.Position.Y
            pcall(function()
                InvisV2.mirrorHRP.CFrame = CFrame.new(h.Position.X, groundY + 3, h.Position.Z)
            end)
        end)
        InvisV2.cleanupConn = LocalPlayer.CharacterAdded:Connect(function()
            if InvisV2.enabled then InvisV2_Cleanup() end
        end)
    else
        if not InvisV2.enabled then return end
        InvisV2_Cleanup()
    end
end

