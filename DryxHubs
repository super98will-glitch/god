function Performance.ToggleAntiLagVisual(enabled)
    Performance.AntiLagVisualEnabled = enabled
    if enabled then
        for o, v in pairs(Performance.AntiLagData) do
            if type(o) == "userdata" and o.Parent then
                if o:IsA("ParticleEmitter") or o:IsA("Trail") then o.Enabled = v
                elseif o:IsA("BasePart") then o.Material = v end
            end
        end
        Performance.AntiLagData = {}
        for _, v in ipairs(Workspace:GetDescendants()) do
            if Helpers.IsCharacterOrDeadBody(v) then continue end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                Performance.AntiLagData[v] = v.Enabled; v.Enabled = false
            elseif v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                Performance.AntiLagData[v] = v.Material; v.Material = Enum.Material.SmoothPlastic
            end
        end
        Performance.AntiLagData["GS"] = Services.Lighting.GlobalShadows
        Services.Lighting.GlobalShadows = false
    else
        for o, v in pairs(Performance.AntiLagData) do
            if type(o) == "userdata" and o.Parent then
                if o:IsA("ParticleEmitter") or o:IsA("Trail") then o.Enabled = v
                elseif o:IsA("BasePart") then o.Material = v end
            elseif o == "GS" then Services.Lighting.GlobalShadows = v end
        end
        Performance.AntiLagData = {}
    end
end
