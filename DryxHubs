-- [[ 1. OFUSCAÇÃO DE URL (NEM APARECE NO CÓDIGO FONTE) ]]
local function _dec_url(hex)
    local bytes = {}
    for char in hex:gmatch("(..)") do
        bytes[#bytes + 1] = tonumber(char, 16)
    end
    return string.char(unpack(bytes))
end

