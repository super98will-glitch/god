    frame.Parent = parent
    makeCorner(frame, Theme.Radius.Small)
    makeStroke(frame, Theme.Border, 1)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 1, -8)
    btn.Position = UDim2.fromOffset(8, 4)
    btn.BackgroundColor3 = Theme.SurfaceSecondary
    btn.BorderSizePixel = 0
    btn.Text = (cfg.Text or "") .. ": " .. tostring(values[currentIdx] or "")
    btn.TextColor3 = Theme.Text
    btn.Font = Theme.Font
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.ZIndex = Z.CONTROL + 1
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = frame
    makeCorner(btn, Theme.Radius.Small)

    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, 0, 0, math.min(150, #values * 26 + 8))
    list.Position = UDim2.new(0, 0, 1, 4)
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = Z.DROPDOWN
    list.ClipsDescendants = true
    list.ScrollBarThickness = 2
    list.Parent = frame
    makeCorner(list, Theme.Radius.Small)
    makeStroke(list, Theme.BorderLight, 1)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = list

    local listPadding = Instance.new("UIPadding")
    listPadding.PaddingTop = UDim.new(0, 4)
    listPadding.PaddingBottom = UDim.new(0, 4)
    listPadding.PaddingLeft = UDim.new(0, 4)
    listPadding.PaddingRight = UDim.new(0, 4)
    listPadding.Parent = list

    local function closeList()
        open = false
        list.Visible = false
    end

    local function select(idx)
        currentIdx = idx
        btn.Text = (cfg.Text or "") .. ": " .. tostring(values[idx])
        pcall(callback, values[idx])
        closeList()
    end

    local function rebuildList()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, v in ipairs(values) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, 0, 0, 22)
            item.BackgroundColor3 = i == currentIdx and Theme.AccentDim or Theme.Card
            item.BorderSizePixel = 0
            item.Text = "  " .. tostring(v)
            item.TextColor3 = i == currentIdx and Theme.Text or Theme.TextSecondary
            item.Font = Theme.Font
            item.TextSize = 11
            item.TextXAlignment = Enum.TextXAlignment.Left
            item.AutoButtonColor = false
            item.ZIndex = Z.DROPDOWN + 1
            item.LayoutOrder = i
            item.Parent = list
            makeCorner(item, Theme.Radius.Small)
            Track(item.MouseButton1Click:Connect(function() select(i) end))
            Track(item.MouseEnter:Connect(function()
                makeTween(item, {BackgroundColor3 = Theme.CardHover}, 0.12)
            end))
            Track(item.MouseLeave:Connect(function()
                local col = i == currentIdx and Theme.AccentDim or Theme.Card
                makeTween(item, {BackgroundColor3 = col}, 0.12)
            end))
        end
        list.CanvasSize = UDim2.new(0, 0, 0, #values * 24 + 8)
    end

    Track(btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            rebuildList()
            list.Visible = true
        else
            closeList()
        end
    end))

    return {
        SetValues = function(newValues)
            values = newValues
            currentIdx = 1
            btn.Text = (cfg.Text or "") .. ": " .. tostring(values[1] or "")
            if open then rebuildList() end
        end,
        Value = function() return values[currentIdx] end,
        Instance = frame,
    }
end

