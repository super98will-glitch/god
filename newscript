    if not wc then return list, nil, nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            local root = Helpers.GetHRP(p.Character)
            if hum and root
                and (hum:GetAttribute("Health") or hum.Health or 0) > 0
                and (root.Position - originPos).Magnitude <= 100 then
                local n = cn == "Gon" and 20 or 50
                for _ = 1, n do table.insert(list, p.Character) end
            end
        end
    end
    return list, wc, cn
end

