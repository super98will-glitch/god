-- SEÇÃO 11: DASH ANTI KNOCKBACK (corrigido)
-- Hooka APENAS Combat.Action.Event. O runAttack original roda
-- intacto. Só os ActionNumbers do PunchDash são reescritos para
-- remover knockback. Preserva timing, hit, ForceDirection, VFX.
-- ================================================================
_G.DashPatcher = {
    Enabled = false,
    Hooked = false,
    OriginalEvent = nil,
    CombatActionModule = nil,
}

local function DP_GetCombatAction()
    local ok, core = pcall(function()
        return require(game:GetService("ReplicatedStorage"):WaitForChild("Core"))
    end)
    if not ok or not core then return nil end
    local ok2, Action = pcall(function() return core.Get("Combat", "Action") end)
    if not ok2 or not Action then return nil end
    return Action
end

local function DP_Enable()
    if _G.DashPatcher.Hooked then return end

    local Action = DP_GetCombatAction()
    if not Action or type(Action.Event) ~= "function" then
        warn("[DashPatcher] Combat.Action.Event não encontrado")
        return
    end

    _G.DashPatcher.CombatActionModule = Action
    _G.DashPatcher.OriginalEvent = Action.Event

    Action.Event = function(self, ...)
        local args = { ... }
        local actionName, params
        for i = 1, #args do
            local v = args[i]
            if type(v) == "string" and actionName == nil then actionName = v end
            if type(v) == "table" and type(v.Replace) == "function" then params = v break end
        end
        if actionName == "PunchDash" and params then
            local originalReplace = params.Replace
            params.Replace = function(target)
                local result = originalReplace(target)
                if type(result) == "table" and type(result.ActionNumbers) == "table" then
                    result.ActionNumbers = { 1, 6 }
                end
                return result
            end
        end
        return _G.DashPatcher.OriginalEvent(self, table.unpack(args))
    end

    _G.DashPatcher.Hooked = true
    _G.DashPatcher.Enabled = true
    print("[DashPatcher] Anti Knockback ON")
end

local function DP_Disable()
    if not _G.DashPatcher.Hooked then return end
    local Action = _G.DashPatcher.CombatActionModule
    if Action and _G.DashPatcher.OriginalEvent then
        Action.Event = _G.DashPatcher.OriginalEvent
    end
    _G.DashPatcher.Hooked = false
    _G.DashPatcher.Enabled = false
    _G.DashPatcher.OriginalEvent = nil
    _G.DashPatcher.CombatActionModule = nil
    print("[DashPatcher] Anti Knockback OFF")
end

