function UIBuilder.Slider(parent, cfg)
    local min = cfg.Min or 0
    local max = cfg.Max or 100
    local current = cfg.Default or min
    local callback = cfg.Callback or function() end
    local rounding = cfg.Rounding or 0

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 46)
    frame.BackgroundColor3 = Theme.Card
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.ZIndex = Z.CONTROL
    frame.Parent = parent
    makeCorner(frame, Theme.Radius.Small)
    makeStroke(frame, Theme.Border, 1)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 18)
    label.Position = UDim2.fromOffset(12, 6)
    label.BackgroundTransparency = 1
    label.Text = cfg.Text or ""
    label.Font = Theme.Font
    label.TextSize = 11
    label.TextColor3 = Theme.TextSecondary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = Z.CONTROL + 1
    label.Parent = frame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.35, 0, 0, 18)
    valLabel.Position = UDim2.new(0.65, -12, 0, 6)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(current)
    valLabel.Font = Theme.FontBold
    valLabel.TextSize = 11
    valLabel.TextColor3 = Theme.Accent
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = Z.CONTROL + 1
    valLabel.Parent = frame

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.fromOffset(12, 32)
    track.BackgroundColor3 = Theme.Background
    track.BorderSizePixel = 0
    track.ZIndex = Z.CONTROL + 1
    track.Parent = frame
    makeCorner(track, Theme.Radius.Pill)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = Z.CONTROL + 2
    fill.Parent = track
    makeCorner(fill, Theme.Radius.Pill)

    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 0, 20)
    hitbox.Position = UDim2.fromOffset(0, -8)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = Z.CONTROL + 3
    hitbox.Parent = track

    local function Update(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local raw = min + ((max - min) * pos)
        local val
        if rounding > 0 then
            local mult = 10 ^ rounding
            val = math.floor(raw * mult + 0.5) / mult
        else
            val = math.floor(raw + 0.5)
        end
        current = val
        fill.Size = UDim2.new(pos, 0, 1, 0)
        valLabel.Text = tostring(val)
        pcall(callback, val)
    end

    Track(hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSlider = {Update = Update}
            Update(input)
        end
    end))

    return {
        Set = function(v)
            current = math.clamp(v, min, max)
            local pos = (current - min) / (max - min)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            valLabel.Text = tostring(current)
            pcall(callback, current)
        end,
        Value = function() return current end,
        Instance = frame,
    }
end

function UIBuilder.Dropdown(parent, cfg)
    local values = cfg.Values or {}
    local currentIdx = 1
    local callback = cfg.Callback or function() end
    local open = false

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 34)
    frame.BackgroundColor3 = Theme.Card
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.ZIndex = Z.CONTROL
