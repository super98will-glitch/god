local InvisV1 = { active = false, blockRemote = false, hooked = false, mt = nil, old = nil }
local function toggleInvisV1(state)
    if state then
        InvisV1.active = true
        local Remote = RC.Replication
        if not Remote then return end
        if not InvisV1.hooked and getrawmetatable and setreadonly then
            InvisV1.hooked = true
            local mt = getrawmetatable(game)
            InvisV1.mt = mt
            setreadonly(mt, false)
            local old = mt.__namecall
            InvisV1.old = old
            mt.__namecall = newcclosure(function(self, ...)
                if self == Remote and getnamecallmethod() == "FireServer" and InvisV1.blockRemote then
                    return nil
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
        end
        local hrp = Helpers.GetHRP(LocalPlayer.Character)
        if not hrp then return end
        local originalCF = hrp.CFrame
        local flyingCF = originalCF + Vector3.new(0, 50000, 0)
        task.spawn(function()
            for _ = 1, 10 do
                hrp.CFrame = flyingCF
                pcall(function() Remote:FireServer() end)
                task.wait(0.1)
            end
            InvisV1.blockRemote = true
            hrp.CFrame = originalCF
        end)
    else
        InvisV1.active = false
        InvisV1.blockRemote = false
    end
end

