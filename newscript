-- ================================================================
-- VISUAL POLISH — CONSOLIDADO
-- Junta: Border Polish + Dropdown ZIndex + Borda Assimétrica + Coroa
-- Nenhuma função, callback ou feature é alterada.
-- ================================================================
task.spawn(function()
    task.wait(0.2)

    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local gui = (_G.__L1GHT_UI and _G.__L1GHT_UI.gui)
             or LocalPlayer.PlayerGui:FindFirstChild("L1GHTHub")
    if not gui then
        warn("[Visual Polish] UI não encontrada.")
        return
    end

    local window = gui:FindFirstChild("Window")
    if not window then return end

    ----------------------------------------------------------------
    -- [1] DROPDOWNS ACIMA DE TUDO
    -- Troca Sibling → Global. Cada ZIndex passa a ser comparado no
    -- ScreenGui inteiro (CONTROL 30 < DROPDOWN 100 < NOTIF 200).
    -- Nenhum ZIndex numérico é alterado.
    ----------------------------------------------------------------
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

    ----------------------------------------------------------------
    -- [2] CANTOS INTERNOS (AccentBar / Header / Sidebar)
    ----------------------------------------------------------------
    local wc = window:FindFirstChildOfClass("UICorner")
    local wR = wc and wc.CornerRadius.Offset or 12

    local accent = window:FindFirstChild("AccentBar")
                or window:FindFirstChild("accentBar")
    if accent and accent:IsA("GuiObject") then
        local ac = accent:FindFirstChildOfClass("UICorner")
        if not ac then
            ac = Instance.new("UICorner")
            ac.Parent = accent
        end
        ac.CornerRadius = UDim.new(0, math.max(0, wR - 1))
    end

    local header = window:FindFirstChild("Header")
    if header and header:IsA("GuiObject") then
        local hc = header:FindFirstChildOfClass("UICorner")
        if not hc then
            hc = Instance.new("UICorner")
            hc.Parent = header
        end
        hc.CornerRadius = UDim.new(0, math.max(0, wR - 2))
    end

    local sidebar = window:FindFirstChild("Sidebar")
    if sidebar and sidebar:IsA("GuiObject") then
        local sc = sidebar:FindFirstChildOfClass("UICorner")
        if not sc then
            sc = Instance.new("UICorner")
            sc.Parent = sidebar
        end
        sc.CornerRadius = UDim.new(0, math.max(0, wR - 2))
    end

    ----------------------------------------------------------------
    -- [3] UISTROKE: remove duplicados, normaliza espessura/alinhamento
    ----------------------------------------------------------------
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UIStroke") then
            local parent = d.Parent
            if not parent or not parent:IsA("GuiObject") then
                d:Destroy()
            else
                local first = parent:FindFirstChildOfClass("UIStroke")
                if first and first ~= d then
                    d:Destroy()
                else
                    d.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    d.LineJoinMode = Enum.LineJoinMode.Round
                    if d.Thickness > 1.4 then d.Thickness = 1.2 end
                    if d.Thickness < 0.8 then d.Thickness = 1 end
                end
            end
        end
    end

    ----------------------------------------------------------------
    -- [4] UICORNER: raio não pode passar da metade do frame
    ----------------------------------------------------------------
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UICorner") and d.Parent and d.Parent:IsA("GuiObject") then
            local p = d.Parent
            local r = d.CornerRadius.Offset
            local maxR = math.min(p.AbsoluteSize.X, p.AbsoluteSize.Y) / 2
            if maxR > 0 and r > maxR then
                d.CornerRadius = UDim.new(0, math.floor(maxR))
            end
        end
    end

    ----------------------------------------------------------------
    -- [5] BORDA ASSIMÉTRICA: topo quadrado, base arredondada
    -- Window.ClipsDescendants = false permite que AccentBar e Header
    -- apareçam como retângulos (cantos retos no topo). A base fica
    -- arredondada por conta do UICorner da própria Window.
    ----------------------------------------------------------------
    window.ClipsDescendants = false
    if not wc then
        wc = Instance.new("UICorner")
        wc.Parent = window
    end
    if wc.CornerRadius.Offset < 8 then
        wc.CornerRadius = UDim.new(0, 12)
    end

    -- tapa o canto arredondado do topo esquerdo/direito com um quadrado
    -- de cor da Window (garante visual 100% quadrado no topo)
    for _, n in ipairs({"__SquareTL", "__SquareTR"}) do
        local old = window:FindFirstChild(n)
        if old then old:Destroy() end
    end

    local R = wc.CornerRadius.Offset
    local capSize = R + 2
    local function makeCap(name, pos)
        local f = Instance.new("Frame")
        f.Name = name
        f.Size = UDim2.fromOffset(capSize, capSize)
        f.Position = pos
        f.BackgroundColor3 = window.BackgroundColor3
        f.BackgroundTransparency = window.BackgroundTransparency
        f.BorderSizePixel = 0
        f.ZIndex = window.ZIndex
        f.Parent = window
    end
    makeCap("__SquareTL", UDim2.fromOffset(-1, -1))
    makeCap("__SquareTR", UDim2.new(1, -capSize + 1, 0, -1))

    ----------------------------------------------------------------
    -- [6] COROA ANTES DE "GOD'S PLAN"
    ----------------------------------------------------------------
    if header then
        for _, c in ipairs(header:GetChildren()) do
            if c:IsA("TextLabel") and c.Text:find("GOD'S PLAN", 1, true) then
                if not c.Text:find("👑", 1, true) then
                    c.Text = "👑 " .. c.Text
                end
                break
            end
        end
    end

    print("[Visual Polish] Patch consolidado aplicado.")
end)
