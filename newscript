-- SEÇÃO 35: INVISIBLE V2 (PLATFORM + MIRROR)
-- ================================================================
local InvisV2 = {
    enabled = false, platform = nil, mirrorModel = nil, mirrorPart = nil,
    originalCameraSubject = nil, movementConnection = nil,
    lastJumpHeight = 0, connections = {}
}
local function toggleInvisV2(state)
    if state then
        if InvisV2.enabled then return end
        local playerCharacter = LocalPlayer.Character
        if not playerCharacter then return end
        local groundUnion
        pcall(function() groundUnion = Workspace.Map.Structural.Ground.Union end)
        if not groundUnion then return end

        local platformPart = Instance.new("Part")
        platformPart.Name = "InvisibilityPlatform"
        platformPart.Size = Vector3.new(2000, 1, 2000)
        platformPart.Position = Vector3.new(
            playerCharacter.HumanoidRootPart.Position.X,
            groundUnion.Position.Y - 20,
            playerCharacter.HumanoidRootPart.Position.Z
        )
        platformPart.Anchored = true
        platformPart.Transparency = 0.5
        platformPart.BrickColor = BrickColor.new("Bright blue")
        platformPart.Parent = Workspace
        InvisV2.platform = platformPart

        if not playerCharacter.Archivable then playerCharacter.Archivable = true end
        local clone = playerCharacter:Clone()
        clone.Name = "MirrorClone"
        clone.Parent = Workspace
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
        end
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.CanCollide = false
                d.Massless = true
                d.Anchored = false
            end
        end
        local hrp = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
        if not hrp then
            clone:Destroy()
            if platformPart then platformPart:Destroy() end
            return
        end
        clone.PrimaryPart = hrp
        local humanoid = clone:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = true
            humanoid.AutoRotate = false
        end
        local srcHRP = playerCharacter:FindFirstChild("HumanoidRootPart")
        if srcHRP then clone:PivotTo(srcHRP.CFrame) end
        InvisV2.mirrorModel = clone
        InvisV2.mirrorPart = hrp
        InvisV2.originalCameraSubject = workspace.CurrentCamera.CameraSubject

        for _, part in pairs(playerCharacter:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        local humanoidRootPart = playerCharacter.HumanoidRootPart
        local originalPosition = humanoidRootPart.Position
        local hum = playerCharacter:FindFirstChildOfClass("Humanoid")
        local hip = hum and hum.HipHeight or 2
        local hrpHalf = humanoidRootPart.Size.Y * 0.5
        local platformTopY = platformPart.Position.Y + (platformPart.Size.Y * 0.5)
        local targetCFrame = CFrame.new(originalPosition.X, platformTopY + hip + hrpHalf, originalPosition.Z)
        pcall(function()
            require(LocalPlayer.PlayerScripts.Character.FullCustomReplication).Override(playerCharacter, targetCFrame)
        end)

        local mirrorHum = clone:FindFirstChildOfClass("Humanoid")
        workspace.CurrentCamera.CameraSubject = mirrorHum or hrp

        InvisV2.movementConnection = RunService.Heartbeat:Connect(function(dt)
            if not InvisV2.enabled then return end
            local currentChar = LocalPlayer.Character
            if not currentChar or not hrp then return end
            local currentHRP = currentChar:FindFirstChild("HumanoidRootPart")
            if not currentHRP then return end
            local groundY
            pcall(function() groundY = Workspace.Map.Structural.Ground.Union.Position.Y end)
            if not groundY then return end
            local platformTopY2 = platformPart and (platformPart.Position.Y + platformPart.Size.Y * 0.5) or groundY
            local targetJumpHeight = math.max(0, (currentHRP.Position.Y - platformTopY2) * 0.5)
            targetJumpHeight = math.min(targetJumpHeight, 20)
            dt = typeof(dt) == "number" and dt or 1/60
            local smoothing = math.clamp(dt * 10, 0, 1)
            InvisV2.lastJumpHeight = InvisV2.lastJumpHeight + (targetJumpHeight - InvisV2.lastJumpHeight) * smoothing
            local halfHeight = 3
            local newPos = Vector3.new(currentHRP.Position.X, groundY + halfHeight + InvisV2.lastJumpHeight, currentHRP.Position.Z)
            local look = currentHRP.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local targetCF
            if flatLook.Magnitude > 0 then
                targetCF = CFrame.new(newPos, newPos + flatLook.Unit)
            else
                targetCF = CFrame.new(newPos)
            end
            if clone and clone.PrimaryPart then clone:PivotTo(targetCF) else hrp.CFrame = targetCF end
        end)
        table.insert(InvisV2.connections, InvisV2.movementConnection)

        local deathConn = LocalPlayer.CharacterAdded:Connect(function()
            if InvisV2.enabled then toggleInvisV2(false) end
        end)
        table.insert(InvisV2.connections, deathConn)
        InvisV2.enabled = true
    else
        if not InvisV2.enabled then return end
        local playerCharacter = LocalPlayer.Character
        if playerCharacter then
            if InvisV2.mirrorModel and InvisV2.mirrorModel.PrimaryPart then
                local humanoidRootPart = playerCharacter.HumanoidRootPart
                local humanoid = playerCharacter:FindFirstChildOfClass("Humanoid")
                local hip = humanoid and humanoid.HipHeight or 2
                local hrpHalf = humanoidRootPart.Size.Y * 0.5
                local groundY
                pcall(function() groundY = Workspace.Map.Structural.Ground.Union.Position.Y end)
                if groundY then
                    local targetCFrame = CFrame.new(
                        InvisV2.mirrorModel.PrimaryPart.Position.X,
                        groundY + hip + hrpHalf,
                        InvisV2.mirrorModel.PrimaryPart.Position.Z
                    )
                    pcall(function()
                        require(LocalPlayer.PlayerScripts.Character.FullCustomReplication).Override(playerCharacter, targetCFrame)
                    end)
                end
            end
            for _, part in pairs(playerCharacter:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
            workspace.CurrentCamera.CameraSubject = playerCharacter:FindFirstChildOfClass("Humanoid") or
                                                   playerCharacter:FindFirstChild("HumanoidRootPart")
        end
        if InvisV2.platform then InvisV2.platform:Destroy() InvisV2.platform = nil end
        if InvisV2.mirrorModel then InvisV2.mirrorModel:Destroy() InvisV2.mirrorModel = nil InvisV2.mirrorPart = nil end
        for _, conn in ipairs(InvisV2.connections) do
            if conn then conn:Disconnect() end
        end
        InvisV2.connections = {}
        InvisV2.movementConnection = nil
        InvisV2.lastJumpHeight = 0
        InvisV2.enabled = false
    end
end

