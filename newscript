        VFX.vfxColorName = name
        if VFX.enabled then VFX_FindAll() VFX_ApplyAll() end
        return true
    end
    return false
end
local function VFX_Start()
    if VFX.trackingThread then return end
    VFX.enabled = true
    VFX.trackingThread = task.spawn(function()
        while VFX.enabled do
            VFX_FindAll()
            VFX_ApplyAll()
            task.wait(0.5)
        end
    end)
end
local function VFX_Stop()
    VFX.enabled = false
    if VFX.trackingThread then task.cancel(VFX.trackingThread) VFX.trackingThread = nil end
    table.clear(VFX.foundVFX)
end

