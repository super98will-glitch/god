local Performance = { AntiLagData = {} }
function Performance.ApplyFPSBoost()
    task.spawn(function()
        local lg = Services.Lighting
        lg.GlobalShadows = false; lg.Brightness = 2; lg.FogEnd = 100
        lg.ClockTime = 14; lg.OutdoorAmbient = Color3.fromRGB(128,128,128)
        pcall(function()
            local t = Workspace.Terrain
            t.WaterWaveSize = 0; t.WaterWaveSpeed = 0; t.WaterReflectance = 0; t.WaterTransparency = 0
        end)
        local all = Workspace:GetDescendants()
        for i = 1, #all, 200 do
            for j = i, math.min(i+199, #all) do
                local v = all[j]
                pcall(function()
                    if Helpers.IsCharacterOrDeadBody(v) then return end
                    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then v.Enabled = false
                    elseif v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Material = Enum.Material.SmoothPlastic; v.CastShadow = false
                    elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1 end
                end)
            end
            task.wait(0.05)
        end
    end)
end
function Performance.ToggleAntiLagVisual(enabled)
    if enabled then
        Performance.AntiLagData = {}
        for _, v in ipairs(Workspace:GetDescendants()) do
            if Helpers.IsCharacterOrDeadBody(v) then continue end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                Performance.AntiLagData[v] = v.Enabled; v.Enabled = false
            elseif v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                Performance.AntiLagData[v] = v.Material; v.Material = Enum.Material.SmoothPlastic
            end
        end
        Performance.AntiLagData["GS"] = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    else
        for o, v in pairs(Performance.AntiLagData) do
            if type(o) == "userdata" and o.Parent then
                if o:IsA("ParticleEmitter") or o:IsA("Trail") then o.Enabled = v
                elseif o:IsA("BasePart") then o.Material = v end
            elseif o == "GS" then Lighting.GlobalShadows = v end
        end
        Performance.AntiLagData = {}
    end
end
Performance.ApplyFPSBoost()

