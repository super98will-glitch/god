local Helpers = {}
function Helpers.IsCharacterOrDeadBody(obj)
    local p = obj
    while p do
        if p:IsA("Model") and (p:FindFirstChildOfClass("Humanoid") or p:FindFirstChild("HumanoidRootPart")) then return true end
        p = p.Parent
    end
    return false
end
function Helpers.GetCharName()
    local ok, v = pcall(function() return LocalPlayer.Data.Character.Value end)
    return ok and v or nil
end
function Helpers.GetHRP(char) return char and char:FindFirstChild("HumanoidRootPart") end
function Helpers.GetWC()
    local cn = Helpers.GetCharName()
    if not cn then return nil, nil end
    local cf = Services.ReplicatedStorage:WaitForChild("Characters"):FindFirstChild(cn)
    if not cf then return nil, nil end
    return cf:FindFirstChild("WallCombo"), cn
end
function Helpers.TriggerDash()
    local hrp = Helpers.GetHRP(LocalPlayer.Character)
    if not hrp then return end
    local dash = Services.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Character"):WaitForChild("Dash")
    pcall(function() dash:FireServer(hrp.CFrame, "L", hrp.CFrame.LookVector, tick()) end)
end
function Helpers.GetClosestPlayer()
    local lh = Helpers.GetHRP(LocalPlayer.Character)
    if not lh then return nil end
    local cl, sh = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        local hrp = Helpers.GetHRP(p.Character)
        if hum and hrp and (hum:GetAttribute("Health") or hum.Health or 0) > 0 then
            local d = (hrp.Position - lh.Position).Magnitude
            if d < sh then sh = d; cl = p end
        end
    end
    return cl
end
function Helpers.GetAlivePlayers()
    local alive = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and (hum:GetAttribute("Health") or hum.Health or 0) > 0 then table.insert(alive, p) end
        end
    end
    return alive
end

