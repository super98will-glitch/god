local Tabs = {}
local TabButtons = {}
local currentTab = nil

local function CreatePage()
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Theme.Border
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.ZIndex = Z.CONTENT + 1
    page.Parent = Content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = page

    return page
end

local function CreateTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = Theme.Card
    btn.BackgroundTransparency = 0.6
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.ZIndex = Z.SIDEBAR + 1
    btn.Parent = Sidebar
    makeCorner(btn, Theme.Radius.Small)

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.fromOffset(2, 12)
    indicator.Position = UDim2.new(0, 4, 0.5, -6)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Name = "Indicator"
    indicator.ZIndex = Z.SIDEBAR + 2
    indicator.Parent = btn
    makeCorner(indicator, Theme.Radius.Pill)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -18, 1, 0)
    label.Position = UDim2.fromOffset(14, 0)
    label.BackgroundTransparency = 1
    label.Text = icon .. " " .. name
    label.Font = Theme.FontBold
    label.TextSize = 10
    label.TextColor3 = Theme.TextSecondary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = Z.SIDEBAR + 2
    label.Parent = btn

    local page = CreatePage()

    Tabs[name] = page
    TabButtons[name] = {btn = btn, indicator = indicator, label = label}

    Track(btn.MouseButton1Click:Connect(function()
        if currentTab == name then return end
        -- Desativa atual
        if currentTab and Tabs[currentTab] then
            Tabs[currentTab].Visible = false
            local ob = TabButtons[currentTab]
            if ob then
                ob.indicator.Visible = false
                ob.btn.BackgroundTransparency = 0.6
                ob.btn.BackgroundColor3 = Theme.Card
                ob.label.TextColor3 = Theme.TextSecondary
            end
        end
        -- Ativa novo
        Tabs[name].Visible = true
        indicator.Visible = true
        btn.BackgroundTransparency = 0.3
        btn.BackgroundColor3 = Theme.AccentDim
        label.TextColor3 = Theme.Text
        currentTab = name
    end))

    Track(btn.MouseEnter:Connect(function()
        if currentTab == name then return end
        makeTween(btn, {BackgroundTransparency = 0.4, BackgroundColor3 = Theme.CardHover}, 0.12)
    end))
    Track(btn.MouseLeave:Connect(function()
        if currentTab == name then return end
        makeTween(btn, {BackgroundTransparency = 0.6, BackgroundColor3 = Theme.Card}, 0.12)
    end))

    return page
end

